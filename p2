function blast() {

    if (
        state.energy < 15
    )
        return;

    state.energy -= 15;

    const direction =
        new THREE.Vector3(
            Math.sin(player.yaw),
            0,
            Math.cos(player.yaw)
        );


    const projectile =
        new THREE.Mesh(
            new THREE.SphereGeometry(
                .25,
                10,
                10
            ),
            new THREE.MeshStandardMaterial({
                color: 0x8ff5ff,
                emissive: 0x8ff5ff
            })
        );


    projectile.position.set(
        player.x,
        player.y,
        player.z
    );


    scene.add(
        projectile
    );


    const velocity =
        direction.multiplyScalar(
            30
        );


    const timer =
        setInterval(
            () => {

                projectile.position.add(
                    velocity.clone()
                    .multiplyScalar(.016)
                );


                for (
                    const enemy
                    of enemies
                ) {

                    if (
                        projectile.position
                        .distanceTo(
                            enemy.mesh.position
                        ) < 1.5
                    ) {

                        enemy.hp -= 20;

                        scene.remove(
                            projectile
                        );

                        clearInterval(
                            timer
                        );


                        if (
                            enemy.hp <= 0
                        ) {

                            scene.remove(
                                enemy.mesh
                            );

                            const index =
                                enemies.indexOf(
                                    enemy
                                );

                            if (
                                index >= 0
                            ) {

                                enemies.splice(
                                    index,
                                    1
                                );

                            }

                            state.credits += 30;

                            state.xp += 30;

                            if (
                                state.xp >= 100
                            ) {

                                state.xp -= 100;

                                state.level++;

                                chat(
                                    "⭐ LEVEL UP!"
                                );

                            }

                            setTimeout(
                                spawnEnemy,
                                1000
                            );

                        }

                    }

                }

            },
            16
        );

}


/* =========================================================
   MOVEMENT
========================================================= */

function updatePlayer(delta) {

    if (!started)
        return;


    let speed = 7;


    if (
        state.className ===
        "Runner"
    ) {

        speed = 9;

    }


    if (
        keys.ShiftLeft ||
        keys.ShiftRight
    ) {

        speed *= 1.5;

    }


    const forward =
        new THREE.Vector3(
            Math.sin(player.yaw),
            0,
            Math.cos(player.yaw)
        );


    const right =
        new THREE.Vector3(
            Math.cos(player.yaw),
            0,
            -Math.sin(player.yaw)
        );


    const movement =
        new THREE.Vector3();


    if (keys.KeyW)
        movement.add(forward);

    if (keys.KeyS)
        movement.add(backward);

    if (keys.KeyD)
        movement.add(right);

    if (keys.KeyA)
        movement.add(left);


    if (
        movement.lengthSq() > 0
    ) {

        movement.normalize();

        player.x +=
            movement.x *
            speed *
            delta;

        player.z +=
            movement.z *
            speed *
            delta;

    }


    if (
        keys.Space &&
        player.grounded
    ) {

        player.velocityY =
            8.5;

        player.grounded =
            false;

    }


    player.velocityY -=
        22 * delta;

    player.y +=
        player.velocityY *
        delta;


    if (
        player.y < 1.8
    ) {

        player.y =
            1.8;

        player.velocityY =
            0;

        player.grounded =
            true;

    }


    state.energy =
        Math.min(
            100,
            state.energy +
            10 * delta
        );


    myAvatar.position.set(
        player.x,
        player.y - 1.8,
        player.z
    );


    myAvatar.rotation.y =
        player.yaw;


    camera.position.set(
        player.x,
        player.y,
        player.z
    );


    camera.rotation.order =
        "YXZ";

    camera.rotation.y =
        player.yaw;

    camera.rotation.x =
        player.pitch;


    sendState();

}


/* =========================================================
   ENEMY AI
========================================================= */

function updateEnemies(delta) {

    for (
        const enemy
        of enemies
    ) {

        const direction =
            new THREE.Vector3(
                player.x -
                enemy.mesh.position.x,

                0,

                player.z -
                enemy.mesh.position.z
            );


        const distance =
            direction.length();


        if (
            distance < 35
        ) {

            direction.normalize();

            enemy.mesh.position.add(
                direction.multiplyScalar(
                    delta * 1.5
                )
            );

        }


        if (
            distance < 2
        ) {

            state.hp -=
                delta * 8;

        }

    }


    if (
        state.hp <= 0
    ) {

        state.hp =
            100;

        player.x =
            0;

        player.z =
            12;

        state.credits =
            Math.max(
                0,
                state.credits - 20
            );

        chat(
            "💥 You respawned!"
        );

    }

}


/* =========================================================
   UI
========================================================= */

function updateUI() {

    document
        .getElementById(
            "playerName"
        )
        .textContent =
        state.name.toUpperCase();


    document
        .getElementById(
            "level"
        )
        .textContent =
        state.level;


    document
        .getElementById(
            "hp"
        )
        .style.width =
        state.hp + "%";


    document
        .getElementById(
            "energy"
        )
        .style.width =
        state.energy + "%";


    document
        .getElementById(
            "xp"
        )
        .style.width =
        state.xp + "%";


    document
        .getElementById(
            "credits"
        )
        .textContent =
        state.credits;


    document
        .getElementById(
            "gems"
        )
        .textContent =
        state.gems;


    document
        .getElementById(
            "world"
        )
        .textContent =
        state.world;

}


/* =========================================================
   START GAME
========================================================= */

document
.getElementById("start")
.addEventListener(
    "click",
    () => {

        state.name =
            document
            .getElementById(
                "name"
            )
            .value ||
            "Player";


        state.className =
            document
            .getElementById(
                "class"
            )
            .value;


        state.skin =
            document
            .getElementById(
                "skin"
            )
            .value;


        state.suit =
            document
            .getElementById(
                "suit"
            )
            .value;


        state.hair =
            document
            .getElementById(
                "hair"
            )
            .value;


        started =
            true;


        document
            .getElementById(
                "menu"
            )
            .style.display =
            "none";


        connect();


        canvas.requestPointerLock();

    }
);


/* =========================================================
   GAME LOOP
========================================================= */

let previous =
    performance.now();


function gameLoop(now) {

    requestAnimationFrame(
        gameLoop
    );


    const delta =
        Math.min(
            (now - previous) /
            1000,
            .05
        );


    previous =
        now;


    updatePlayer(delta);

    updateEnemies(delta);

    updateUI();


    renderer.render(
        scene,
        camera
    );

}


gameLoop(
    previous
);


/* =========================================================
   RESIZE
========================================================= */

window.addEventListener(
    "resize",
    () => {

        camera.aspect =
            innerWidth /
            innerHeight;

        camera.updateProjectionMatrix();

        renderer.setSize(
            innerWidth,
            innerHeight
        );

    }
);

</script>

</body>

</html>
