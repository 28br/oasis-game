server_py = r'''
import asyncio
import json
import os
from pathlib import Path
from http.server import SimpleHTTPRequestHandler
from socketserver import ThreadingTCPServer
import threading

# ------------------------------------------------------------
# Simple HTTP server
# ------------------------------------------------------------

PORT = 3000
ROOT = Path(__file__).parent / "public"


class GameHTTP(SimpleHTTPRequestHandler):

    def __init__(self, *args, **kwargs):
        super().__init__(*args, directory=str(ROOT), **kwargs)

    def log_message(self, format, *args):
        pass


def http_server():
    server = ThreadingTCPServer(("0.0.0.0", PORT), GameHTTP)
    print(f"HTTP server running at http://localhost:{PORT}")
    server.serve_forever()


# ------------------------------------------------------------
# Game state
# ------------------------------------------------------------

players = {}


def clean_player(player):
    return {
        "id": player["id"],
        "name": player["name"],
        "x": player["x"],
        "y": player["y"],
        "z": player["z"],
        "yaw": player["yaw"],
        "world": player["world"],
        "skin": player["skin"],
        "suit": player["suit"],
        "hair": player["hair"],
        "className": player["className"],
        "level": player["level"],
        "hp": player["hp"],
        "vehicle": player["vehicle"],
    }


# ------------------------------------------------------------
# Optional WebSocket multiplayer server
# ------------------------------------------------------------

async def websocket_server():

    try:
        import websockets
    except ImportError:
        print()
        print("WebSocket package is missing.")
        print("Install it with:")
        print()
        print("pip install websockets")
        print()
        return

    async def handler(websocket):
        player_id = str(id(websocket))

        player = {
            "id": player_id,
            "name": "Player",
            "x": 0,
            "y": 1.8,
            "z": 12,
            "yaw": 0,
            "world": "OASIS City",
            "skin": "#d59b72",
            "suit": "#26caff",
            "hair": "#171923",
            "className": "Runner",
            "level": 1,
            "hp": 100,
            "vehicle": "None",
        }

        players[player_id] = player

        await websocket.send(json.dumps({
            "type": "welcome",
            "id": player_id,
            "players": list(players.values())
        }))

        try:
            async for raw in websocket:

                try:
                    message = json.loads(raw)
                except:
                    continue

                if message.get("type") == "state":

                    for key in [
                        "name",
                        "x",
                        "y",
                        "z",
                        "yaw",
                        "world",
                        "skin",
                        "suit",
                        "hair",
                        "className",
                        "level",
                        "hp",
                        "vehicle"
                    ]:
                        if key in message:
                            player[key] = message[key]

                    packet = json.dumps({
                        "type": "update",
                        "player": clean_player(player)
                    })

                    dead = []

                    for pid, connection in connections.items():

                        if connection == websocket:
                            continue

                        try:
                            await connection.send(packet)
                        except:
                            dead.append(pid)

                    for pid in dead:
                        connections.pop(pid, None)

                elif message.get("type") == "chat":

                    text = str(message.get("text", ""))[:160]

                    packet = json.dumps({
                        "type": "chat",
                        "name": player["name"],
                        "text": text
                    })

                    for connection in list(connections.values()):
                        try:
                            await connection.send(packet)
                        except:
                            pass

                elif message.get("type") == "event":

                    packet = json.dumps({
                        "type": "event",
                        "name": player["name"],
                        "kind": str(message.get("kind", ""))[:40]
                    })

                    for connection in list(connections.values()):
                        try:
                            await connection.send(packet)
                        except:
                            pass

        finally:
            players.pop(player_id, None)
            connections.pop(player_id, None)

    connections = {}

    async def wrapped(websocket):
        connections[str(id(websocket))] = websocket
        await handler(websocket)

    print("Starting multiplayer WebSocket server...")

    async with websockets.serve(
        wrapped,
        "0.0.0.0",
        3001
    ):
        await asyncio.Future()


# ------------------------------------------------------------
# Start everything
# ------------------------------------------------------------

if __name__ == "__main__":

    threading.Thread(
        target=http_server,
        daemon=True
    ).start()

    print()
    print("=" * 55)
    print("        MINI-OASIS 3 MULTIPLAYER")
    print("=" * 55)
    print()
    print("Game:       http://localhost:3000")
    print("Multiplayer ws://localhost:3001")
    print()
    print("Keep this window open while playing.")
    print()

    try:
        asyncio.run(websocket_server())
    except KeyboardInterrupt:
        print("Server stopped.")
'''

