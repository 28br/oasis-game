        return;

    if (
        !otherModels.has(data.id)
    ) {

        addOtherPlayer(data);

        return;

    }

    const model =
        otherModels.get(data.id);

    model.position.set(
        data.x,
        data.y - 1.8,
        data.z
    );

    model.rotation.y =
        data.yaw;

    otherPlayers.set(
        data.id,
        data
    );

}


