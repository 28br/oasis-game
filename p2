/* =========================================================
   MULTIPLAYER
========================================================= */

let socket = null;

let myId = null;

let lastSend = 0;


function connect() {

    socket =
        new WebSocket(
            "ws://" +
            location.hostname +
            ":3001"
        );


    socket.onopen =
        () => {

            chat(
                "🌐 Connected to the OASIS."
            );

            sendState();

        };


    socket.onmessage =
        event => {

            const data =
                JSON.parse(
                    event.data
                );


            if (
                data.type ===
                "welcome"
            ) {

                myId =
                    data.id;

                for (
                    const p
                    of data.players
                ) {

                    addOtherPlayer(p);

                }

            }


            if (
                data.type ===
                "update"
            ) {

                updatePlayer(
                    data.player
                );

            }


            if (
                data.type ===
                "join"
            ) {

                addOtherPlayer(
                    data.player
                );

                chat(
                    "👋 " +
                    data.player.name +
                    " entered the OASIS."
                );

            }


            if (
                data.type ===
                "leave"
            ) {

                removeOtherPlayer(
                    data.id
                );

            }


            if (
                data.type ===
                "chat"
            ) {

                chat(
                    "💬 " +
                    data.name +
                    ": " +
                    data.text
                );

            }

        };

}


function sendState() {

    if (
        !socket ||
        socket.readyState !== 1
    )
        return;


    if (
        performance.now()
        - lastSend
        < 50
    )
        return;


    socket.send(
        JSON.stringify({

            type: "state",

            ...state,

            x: player.x,

            y: player.y,

            z: player.z,

            yaw: player.yaw

        })
    );


    lastSend =
        performance.now();

}


